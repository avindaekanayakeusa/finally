# Required for live chat (not needed when LLM_MOCK=true): OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# If not set, the built-in market simulator is used (recommended for most users).
MASSIVE_API_KEY=

# Optional: Massive poll interval in seconds (default 15, minimum 1).
# Free tier (5 req/min) needs >= 15; paid tiers can use 2-5.
# MASSIVE_POLL_INTERVAL=15

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
